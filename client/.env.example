# API Configuration
# For development, use http://localhost:4000/api/v1
# For production, use your production API URL (e.g., https://api.yourdomain.com/api/v1)
VITE_API_URL=http://localhost:4000/api/v1

# Google sign-in (optional). OAuth 2.0 Web client ID from Google Cloud Console.
# The server must have the same value in GOOGLE_CLIENT_ID. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
